# Production secrets template.
#
# In Dokploy: paste these into the project's "Environment" panel.
# Outside Dokploy: copy to develop/.env and fill in real values, then
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
#
# Generate each secret with:  openssl rand -hex 32
# DO NOT commit .env to git.

# --- Domains -----------------------------------------------------------------
# Main user-facing domain. Where users open the editor.
OVERLEAF_SITE_URL=https://overleaf.example.com
OVERLEAF_DOMAIN=overleaf.example.com

# Separate origin for compiled PDF/HTML output. MUST be a different domain
# (or at minimum a different subdomain) from OVERLEAF_DOMAIN — this is the
# user-content isolation boundary that prevents XSS via crafted LaTeX output.
COMPILES_USER_CONTENT_DOMAIN=https://output.example.com
OVERLEAF_OUTPUT_DOMAIN=output.example.com

# --- Dokploy / Traefik -------------------------------------------------------
# Name of the external Docker network Traefik joins. Dokploy defaults to
# "dokploy-network". Override if your install uses a different name.
DOKPLOY_NETWORK=dokploy-network

# --- Session + service-to-service auth ---------------------------------------
# Express session signing key. Rotating this logs everyone out.
SESSION_SECRET=

# Web's internal HTTP API basic-auth (used by background services).
WEB_API_USER=overleaf
WEB_API_PASSWORD=

# history-v1 basic-auth password. Username is hardcoded to "staging".
V1_HISTORY_PASS=
# history-v1 also reads this name; keep both in sync.
STAGING_PASSWORD=

# JWT key for history-v1 token auth.
OT_JWT_AUTH_KEY=

# --- LLM agent ---------------------------------------------------------------
# Portkey gateway credentials (or swap for direct provider keys if you change
# the llm-agent backend).
PORTKEY_API_KEY=
PORTKEY_VIRTUAL_KEY=
PORTKEY_CONFIG=
PORTKEY_BASE_URL=
LLM_MODEL=
LLM_JUDGE_MODEL=
